# ---- Landing AI (ADE Gen2 / DPT-3) ----
LANDING_API_KEY=APIKEYHERE
LANDING_BASE_URL=https://api.ade.landing.ai
PARSE_MODEL=dpt-3-pro-latest
VERITY_MODEL=dpt-3-verity-latest
EXTRACT_MODEL=extract-latest

# ---- Storage ----
DATA_DIR=data

# ---- Canonicalization ----
RENDER_DPI=300
MAX_LONG_SIDE=6000
EMBEDDED_MIN_LONG_SIDE=1500
PHOTO_RECTIFY=auto
NORMALIZE_ILLUMINATION=true
DESKEW=true
MIN_SHORT_SIDE_PX=1000
BLUR_THRESHOLD=60

# ---- Parsing / batching ----
BATCH_PAGES=10
MAX_UPLOAD_MB=45
HTTP_TIMEOUT=300
MAX_RETRIES=4

# ---- Question / option / image policy ----
# visual_only | visual_or_math | always
OPTION_IMAGE_MODE=visual_only
ASSET_PAD_PX=8
MIN_ASSET_PX=24
REPASS_MIN_SIDE=1000
# photo pages only: max regions per page sent in ONE mosaic repass call (0 disables repass)
REPASS_MAX_PER_PAGE=4
# auto: born-digital pages are uploaded as original PDF pages | canonical: always the rendered PNG
PARSE_SOURCE=auto
INK_THRESHOLD=120
INK_MIN_BBOX_FRAC=0.002
GUTTER_CLUSTER_TOL=0.025
MIN_ANCHOR_GAP_FRAC=0.04
MIN_CLUSTER_SIZE=2
# extra room below the LAST question of a column (unparsed images can hang below the last parsed block)
LAST_REGION_PAD_FRAC=0.03

# ---- Extras ----
QA_VERITY=false
LADDER_PROFILES=no_rectify,force_rectify,hires
LADDER_MAX_PAGES=20
DEBUG_OVERLAYS=true
# overlays for every page (slow) instead of only pages with errors
OVERLAYS_ALL=false
# one mosaic call per page whose images have no Landing AI description yet
DESCRIBE_IMAGES=true
LOG_LEVEL=INFO
# Regex lists are separated by ||
WATERMARK_PATTERNS=matrix\s*science\s*academy||^\s*MSA\s*$
ANSWER_MARKERS=correct\s*option||^\s*answer\s*[:.]||^\s*ans\s*[:.]
