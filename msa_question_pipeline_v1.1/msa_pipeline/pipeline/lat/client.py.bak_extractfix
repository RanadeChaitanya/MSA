import json
import logging
import time
from typing import Any, Dict, Optional, Tuple, Union

import requests

logger = logging.getLogger(__name__)


class LatError(Exception):
    pass


class LatClient:
    def __init__(
        self,
        api_key: Union[str, Any],
        base_url: str = "https://api.ade.landing.ai",
        parse_model: str = "dpt-3-pro-latest",
        verity_model: str = "dpt-3-verity-latest",
    ):
        if not isinstance(api_key, str):
            cfg = api_key
            api_key = (
                getattr(cfg, "api_key", None)
                or getattr(cfg, "landing_api_key", None)
                or ""
            )
            base_url = getattr(cfg, "base_url", None) or getattr(cfg, "landing_base_url", base_url)
            parse_model = getattr(cfg, "parse_model", parse_model)
            verity_model = (
                getattr(cfg, "verify_model", None)
                or getattr(cfg, "verity_model", verity_model)
            )

        self.api_key = (api_key or "").strip()
        if not self.api_key:
            raise LatError("Empty API key. Set LANDING_API_KEY in .env")

        self.base_url = base_url.rstrip("/")
        self.parse_model = parse_model
        self.verity_model = verity_model
        self.extract_model = getattr(self, "extract_model", None) or parse_model
        self.credits = 0.0
        self.calls = {}
        self.cache_hits = 0

        self.session = requests.Session()
        self._auth_header = self._pick_auth_header(self.api_key)
        self.session.headers.update({
            "Authorization": self._auth_header,
            "User-Agent": "msa-pipeline/1.1",
        })
        logger.info("LatClient ready: %s @ %s (key_len=%d)",
                    self._auth_header.split(" ", 1)[0], self.base_url, len(self.api_key))

    # ------------------------------------------------------------------ #
    @staticmethod
    def _pick_auth_header(api_key: str) -> str:
        k = api_key.strip()
        if k.startswith("Basic ") or k.startswith("Bearer "):
            return k
        if k.startswith("land_") or k.startswith("APIKEY") or len(k) < 80:
            return f"Bearer {k}"
        return f"Basic {k}"

    @staticmethod
    def _mime_for(filename: str) -> str:
        low = (filename or "").lower()
        if low.endswith(".pdf"):                 return "application/pdf"
        if low.endswith(".png"):                 return "image/png"
        if low.endswith((".jpg", ".jpeg")):      return "image/jpeg"
        if low.endswith((".tif", ".tiff")):      return "image/tiff"
        return "application/octet-stream"

    # ------------------------------------------------------------------ #
    def _post(
        self,
        path: str,
        data: Optional[Dict[str, Any]] = None,
        files: Optional[Dict[str, Any]] = None,
        json_data: Optional[Dict[str, Any]] = None,
        timeout: Tuple[int, int] = (15, 120),
        max_attempts: int = 3,
    ) -> Dict[str, Any]:
        url = f"{self.base_url}{path}"
        kw: Dict[str, Any] = {"timeout": timeout}
        if data:      kw["data"] = data
        if files:     kw["files"] = files
        if json_data: kw["json"] = json_data

        last_err: Optional[Exception] = None
        for attempt in range(1, max_attempts + 1):
            try:
                resp = self.session.post(url, **kw)
                if resp.status_code == 200:
                    return resp.json()

                body = resp.text[:800]

                if resp.status_code in (401, 402, 403):
                    raise LatError(f"{path} -> HTTP {resp.status_code}: {body}")
                if 400 <= resp.status_code < 500:
                    raise LatError(f"{path} -> HTTP {resp.status_code}: {body}")

                last_err = LatError(f"{path} -> HTTP {resp.status_code}: {body}")
            except requests.RequestException as e:
                last_err = e
            except LatError:
                raise

            if attempt < max_attempts:
                sleep_s = 2 ** attempt
                logger.warning("retry %d/%d on %s in %ds: %s",
                               attempt, max_attempts, path, sleep_s, last_err)
                time.sleep(sleep_s)

        raise LatError(f"Failed after {max_attempts} attempts on {path}: {last_err}")

    # ------------------------------------------------------------------ #
    def parse(
        self,
        image_bytes: bytes,
        filename: str = "page.png",
        options: Optional[Dict[str, Any]] = None,
        model: Optional[str] = None,
    ) -> Dict[str, Any]:
        target_model = model or self.parse_model
        data: Dict[str, Any] = {"model": target_model}
        if options:
            data["options"] = json.dumps(options)
        mime = self._mime_for(filename)
        files = {"document": (filename, image_bytes, mime)}
        return self._post("/v2/parse", data=data, files=files)

    # ------------------------------------------------------------------ #
    def extract(self, *args, **kwargs) -> Dict[str, Any]:
        """Permissive extract() — sniffs positional args and named kwargs.

        Accepts ANY of these call styles:
            client.extract(bytes, schema=...)
            client.extract(bytes, schema_dict, filename)
            client.extract(schema=schema, document=bytes)
            client.extract(document_bytes=bytes, schema=schema, model=m)
            client.extract(buf, "page.png", schema=schema)
        """
        # --- named kwargs, case-insensitive alias matching -----------
        document_bytes = None
        filename = "document.pdf"
        schema = None
        model = None
        options = None
        prompt = None

        doc_aliases = {
            "document", "document_bytes", "image_bytes", "data", "content",
            "payload", "bytes", "buf", "pdf", "file", "file_bytes",
        }
        name_aliases = {"filename", "name", "file_name"}
        schema_aliases = {"schema", "output_schema", "json_schema", "structure", "extraction_schema"}
        model_aliases = {"model", "model_id"}
        opt_aliases = {"options", "opts"}
        prompt_aliases = {"prompt", "instruction", "instructions"}

        rest_kwargs: Dict[str, Any] = {}
        for k, v in kwargs.items():
            kl = k.lower()
            if kl in doc_aliases:
                if document_bytes is None and v is not None:
                    document_bytes = v
            elif kl in name_aliases:
                if isinstance(v, str):
                    filename = v
            elif kl in schema_aliases:
                if schema is None:
                    schema = v
            elif kl in model_aliases:
                model = v
            elif kl in opt_aliases:
                options = v
            elif kl in prompt_aliases:
                prompt = v
            else:
                rest_kwargs[k] = v

        # --- positional sniffing ------------------------------------
        for arg in args:
            if arg is None:
                continue
            if isinstance(arg, (bytes, bytearray, memoryview)):
                if document_bytes is None:
                    document_bytes = bytes(arg)
                continue
            if isinstance(arg, dict):
                if schema is None:
                    schema = arg
                continue
            if isinstance(arg, str):
                low = arg.lower()
                if low.endswith((".pdf", ".png", ".jpg", ".jpeg", ".tif", ".tiff")):
                    filename = arg
                elif arg.lstrip().startswith("{") or arg.lstrip().startswith("["):
                    if schema is None:
                        schema = arg
                elif model is None and 3 < len(arg) < 60 and " " not in arg:
                    # looks like a model id
                    model = arg
                else:
                    filename = arg
                continue
            # If it's a Path, treat as filename
            try:
                import pathlib
                if isinstance(arg, pathlib.Path):
                    filename = arg.name
                    continue
            except Exception:
                pass

        if document_bytes is None:
            raise LatError(
                f"extract(): could not find document bytes. "
                f"positional types={[type(a).__name__ for a in args]}, "
                f"kwargs={list(kwargs.keys())}"
            )
        # Auto-read string paths (belt & suspenders)
        if isinstance(document_bytes, (str,)):
            from pathlib import Path as _P
            _p = _P(document_bytes)
            if _p.exists() and _p.is_file():
                if filename == "document.pdf":
                    filename = _p.name
                document_bytes = _p.read_bytes()
            else:
                document_bytes = document_bytes.encode("utf-8")
        elif isinstance(document_bytes, (bytearray, memoryview)):
            document_bytes = bytes(document_bytes)

        # --- build request ------------------------------------------
        target_model = model or self.extract_model or self.parse_model
        mime = self._mime_for(filename)

        data: Dict[str, Any] = {"model": target_model}
        if schema is not None:
            data["schema"] = schema if isinstance(schema, str) else json.dumps(schema)
        if prompt:
            data["prompt"] = prompt
        if options:
            data["options"] = options if isinstance(options, str) else json.dumps(options)
        for k, v in rest_kwargs.items():
            if v is None:
                continue
            data[k] = v if isinstance(v, str) else json.dumps(v)

        # --- try endpoint × field combinations ----------------------
        endpoints = ["/v2/extract", "/v1/extract", "/v2/parse/extract", "/v2/document/extract"]
        fields = ["document", "file"]

        last_exc: Optional[Exception] = None
        for field in fields:
            files = {field: (filename, document_bytes, mime)}
            for endpoint in endpoints:
                try:
                    resp_json = self._post(endpoint, data=dict(data), files=files)
                    # tally
                    self.calls[endpoint] = self.calls.get(endpoint, 0) + 1
                    if isinstance(resp_json, dict):
                        for kk in ("credits_used", "credits", "credit_cost", "cost"):
                            vv = resp_json.get(kk)
                            if isinstance(vv, (int, float)):
                                self.credits += float(vv)
                                break
                    logger.info("extract OK: endpoint=%s field=%s", endpoint, field)
                    return resp_json
                except Exception as e:
                    last_exc = e
                    msg = str(e)
                    # 404 → try next endpoint
                    if "HTTP 404" in msg:
                        continue
                    # 422 with "document" required → try next field
                    if "422" in msg and "document" in msg and field == "document":
                        break
                    # any other error → bubble up
                    raise
        raise last_exc if last_exc else RuntimeError("extract failed with no endpoints matching")
